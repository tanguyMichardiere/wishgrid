{
	"name": "wishgrid",
	"private": true,
	"engines": {
		"node": "20.12.2",
		"pnpm": "9"
	},
	"pnpm": {
		"supportedArchitectures": {
			"os": [
				"linux",
				"current"
			],
			"cpu": [
				"x64",
				"current"
			]
		}
	},
	"scripts": {
		"postinstall": "prisma generate --no-hints",
		"update-dependencies": "sh scripts/update-dependencies.sh",
		"env-pull": "vercel env pull .env",
		"dev": "next dev",
		"format": "biome format --write .",
		"lint": "biome ci --error-on-warnings .",
		"check-types": "tsc",
		"check-dead-code": "knip",
		"quality": "pnpm run lint && pnpm run check-types && pnpm run check-dead-code",
		"analyze-bundle": "cross-env ANALYZE=true next build",
		"migrate": "prisma migrate deploy",
		"build": "next build",
		"start": "next start"
	},
	"dependencies": {
		"@auth/prisma-adapter": "2.5.0",
		"@headlessui/react": "2.1.8",
		"@heroicons/react": "2.1.5",
		"@hookform/resolvers": "3.9.0",
		"@prisma/client": "5.19.1",
		"@t3-oss/env-nextjs": "0.11.1",
		"@tailwindcss/container-queries": "0.1.1",
		"@tailwindcss/forms": "0.5.9",
		"@tailwindcss/typography": "0.5.15",
		"@tanstack/react-query": "5.56.2",
		"@tanstack/react-query-devtools": "5.56.2",
		"@trpc/client": "11.0.0-rc.522",
		"@trpc/next": "11.0.0-rc.522",
		"@trpc/react-query": "11.0.0-rc.522",
		"@trpc/server": "11.0.0-rc.522",
		"@vercel/analytics": "1.3.1",
		"@vercel/speed-insights": "1.0.12",
		"classix": "2.1.38",
		"client-only": "0.0.1",
		"csv-stringify": "6.5.1",
		"daisyui": "4.12.10",
		"devalue": "5.0.0",
		"docx": "8.5.0",
		"next": "14.2.13",
		"next-auth": "5.0.0-beta.21",
		"next-intl": "3.19.4",
		"next-themes": "0.3.0",
		"pdfkit": "0.15.0",
		"prisma-query-formatter": "0.1.3",
		"qrcode.react": "4.0.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-hook-form": "7.53.0",
		"react-hot-toast": "2.4.1",
		"server-only": "0.0.1",
		"sharp": "0.32.6",
		"superjson": "2.2.1",
		"tslib": "2.7.0",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.2",
		"@next/bundle-analyzer": "14.2.13",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "20.12.2",
		"@types/pdfkit": "0.13.5",
		"@types/react": "18.3.8",
		"@types/react-dom": "18.3.0",
		"autoprefixer": "10.4.20",
		"cross-env": "7.0.3",
		"jiti": "1.21.6",
		"knip": "5.30.2",
		"npm-check-updates": "17.1.2",
		"postcss": "8.4.47",
		"postcss-flexbugs-fixes": "5.0.2",
		"postcss-preset-env": "10.0.3",
		"prisma": "5.19.1",
		"tailwindcss": "3.4.12",
		"typescript": "5.6.2",
		"vercel": "37.5.3",
		"webpack": "5.94.0"
	}
}
