{
	"name": "wishgrid",
	"private": true,
	"pnpm": {
		"supportedArchitectures": {
			"os": ["linux", "current"],
			"cpu": ["x64", "current"]
		}
	},
	"scripts": {
		"postinstall": "prisma generate --no-hints",
		"update-dependencies": "sh scripts/update-dependencies.sh",
		"env-pull": "vercel env pull .env",
		"dev": "next dev --turbopack",
		"format": "biome format --write .",
		"lint": "biome ci --error-on-warnings .",
		"check-types": "tsc",
		"check-dead-code": "knip",
		"quality": "pnpm run lint && pnpm run check-types && pnpm run check-dead-code",
		"analyze-bundle": "cross-env ANALYZE=true next build",
		"migrate": "prisma migrate deploy",
		"build": "next build",
		"start": "next start"
	},
	"dependencies": {
		"@auth/prisma-adapter": "2.7.4",
		"@headlessui/react": "2.2.0",
		"@heroicons/react": "2.2.0",
		"@hookform/resolvers": "3.10.0",
		"@prisma/client": "6.2.1",
		"@t3-oss/env-nextjs": "0.12.0",
		"@tailwindcss/container-queries": "0.1.1",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.16",
		"@tanstack/react-query": "5.65.0",
		"@tanstack/react-query-devtools": "5.65.0",
		"@trpc/client": "11.0.0-rc.730",
		"@trpc/next": "11.0.0-rc.730",
		"@trpc/react-query": "11.0.0-rc.730",
		"@trpc/server": "11.0.0-rc.730",
		"@vercel/analytics": "1.4.1",
		"@vercel/speed-insights": "1.1.0",
		"classix": "2.2.1",
		"client-only": "0.0.1",
		"csv-stringify": "6.5.2",
		"daisyui": "5.0.0-beta.2",
		"devalue": "5.1.1",
		"docx": "9.1.1",
		"next": "15.1.6",
		"next-auth": "5.0.0-beta.25",
		"next-intl": "3.26.3",
		"next-themes": "0.4.4",
		"pdfkit": "0.16.0",
		"prisma-query-formatter": "0.2.2",
		"qrcode.react": "4.2.0",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-hook-form": "7.54.2",
		"react-hot-toast": "2.5.1",
		"server-only": "0.0.1",
		"sharp": "0.33.5",
		"superjson": "2.2.2",
		"tslib": "2.8.1",
		"zod": "3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@next/bundle-analyzer": "15.1.6",
		"@tailwindcss/postcss": "4.0.0",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "22.10.10",
		"@types/pdfkit": "0.13.8",
		"@types/react": "19.0.8",
		"@types/react-dom": "19.0.3",
		"babel-plugin-react-compiler": "19.0.0-beta-e552027-20250112",
		"cross-env": "7.0.3",
		"jiti": "2.4.2",
		"knip": "5.43.5",
		"npm-check-updates": "17.1.14",
		"postcss": "8.5.1",
		"prisma": "6.2.1",
		"tailwindcss": "4.0.0",
		"typescript": "5.7.3",
		"vercel": "39.3.0",
		"webpack": "5.97.1"
	}
}
