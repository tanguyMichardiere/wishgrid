{
	"name": "wishgrid",
	"private": true,
	"engines": {
		"node": "20.12.2",
		"pnpm": "9"
	},
	"pnpm": {
		"supportedArchitectures": {
			"os": ["linux", "current"],
			"cpu": ["x64", "current"]
		}
	},
	"scripts": {
		"postinstall": "prisma generate",
		"update-dependencies": "sh scripts/update-dependencies.sh",
		"env-pull": "vercel env pull .env",
		"dev": "next dev --turbo",
		"format": "biome format --write .",
		"check-format": "biome format .",
		"lint": "biome lint .",
		"check-types": "tsc",
		"check-dead-code": "knip",
		"quality": "pnpm run check-format && pnpm run lint && pnpm run check-types && pnpm run check-dead-code",
		"analyze-bundle": "cross-env ANALYZE=true next build",
		"migrate": "prisma migrate deploy",
		"build": "next build",
		"start": "next start"
	},
	"dependencies": {
		"@auth/prisma-adapter": "2.2.0",
		"@headlessui/react": "2.0.4",
		"@heroicons/react": "2.1.3",
		"@hookform/resolvers": "3.6.0",
		"@prisma/client": "5.15.0",
		"@t3-oss/env-nextjs": "0.10.1",
		"@tailwindcss/container-queries": "0.1.1",
		"@tailwindcss/forms": "0.5.7",
		"@tailwindcss/typography": "0.5.13",
		"@tanstack/react-query": "5.45.0",
		"@tanstack/react-query-devtools": "5.45.0",
		"@trpc/client": "11.0.0-rc.403",
		"@trpc/next": "11.0.0-rc.403",
		"@trpc/react-query": "11.0.0-rc.403",
		"@trpc/server": "11.0.0-rc.403",
		"@vercel/analytics": "1.3.1",
		"@vercel/speed-insights": "1.0.12",
		"classix": "2.1.37",
		"client-only": "0.0.1",
		"csv-stringify": "6.5.0",
		"daisyui": "4.12.2",
		"devalue": "5.0.0",
		"docx": "8.5.0",
		"next": "14.2.4",
		"next-auth": "5.0.0-beta.19",
		"next-intl": "3.15.0",
		"next-themes": "0.3.0",
		"pdfkit": "0.15.0",
		"qrcode.react": "3.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-hook-form": "7.51.5",
		"react-hot-toast": "2.4.1",
		"server-only": "0.0.1",
		"sharp": "0.32.6",
		"superjson": "2.2.1",
		"tslib": "2.6.3",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.1",
		"@next/bundle-analyzer": "14.2.4",
		"@total-typescript/ts-reset": "0.5.1",
		"@types/node": "20.12.2",
		"@types/pdfkit": "0.13.4",
		"@types/react": "18.3.3",
		"@types/react-dom": "18.3.0",
		"autoprefixer": "10.4.19",
		"cross-env": "7.0.3",
		"jiti": "1.21.6",
		"knip": "5.19.0",
		"npm-check-updates": "16.14.20",
		"postcss": "8.4.38",
		"postcss-flexbugs-fixes": "5.0.2",
		"postcss-preset-env": "9.5.14",
		"prisma": "5.15.0",
		"tailwindcss": "3.4.4",
		"typescript": "5.4.5",
		"vercel": "34.2.7",
		"webpack": "5.92.0"
	}
}
