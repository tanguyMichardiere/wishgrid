{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"ignore": ["**/*.yml"]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"defaultBranch": "production"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"all": true,
			"correctness": {
				"useImportExtensions": "off"
			},
			"suspicious": {
				"noReactSpecificProps": "off"
			},
			"style": {
				"useDefaultSwitchClause": "off" // checked by typescript
			},
			"nursery": {
				"all": true,
				"noExportedImports": "off", // conflicts with lint/performance/noBarrelFile
				"useComponentExportOnlyModules": "off",
				"useImportRestrictions": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100
	},
	"organizeImports": { "enabled": true },
	"overrides": [
		{
			// VSCode JSON files are actually JSONC
			"include": [".vscode/*.json"],
			"json": {
				"parser": { "allowComments": true }
			}
		},
		{
			"include": [
				// NextJS component files use default exports
				"src/app/**/default.tsx",
				"src/app/**/error.tsx",
				"src/app/**/layout.tsx",
				"src/app/**/loading.tsx",
				"src/app/**/not-found.tsx",
				"src/app/**/page.tsx",
				"src/app/**/template.tsx",
				"src/middleware.ts",
				// most config files use default exports
				"*.config.ts",
				"*.config.mjs"
			],
			"linter": {
				"rules": {
					"style": { "noDefaultExport": "off" }
				}
			}
		},
		{
			"include": [
				// environment variable names are not in camelCase
				"src/env.ts",
				// TRPC error codes are not in camelCase
				"src/utils/server-queries/**/*.ts"
			],
			"linter": {
				"rules": {
					"style": { "useNamingConvention": "off" }
				}
			}
		}
	]
}
